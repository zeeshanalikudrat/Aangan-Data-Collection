# Admin Credentials (Set your own secure credentials)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here

# Google Apps Script Web App URL (Deploy Code.gs as Web App and paste URL here)
GAS_BASE_URL=

# Master Google Spreadsheet ID (Contains ONLY: Location-List, Dropdown-List, Forms-Details)
MASTER_SPREADSHEET_ID=

# Central Google Drive Root Folder ID
ROOT_DRIVE_FOLDER_ID=

# Portal App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aangan Trust Portal
